# Backend Environment Variables
# Copy this file to .env and fill in your values

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local MongoDB (default) — make sure mongod is running on port 27017:
MONGODB_URI=mongodb://127.0.0.1:27017/genericmed

# MongoDB Atlas (cloud) example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/genericmed?retryWrites=true&w=majority

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# Change this to a strong random string in production!
JWT_SECRET=your_super_secret_jwt_key_change_me

# ─── Server Port ──────────────────────────────────────────────────────────────
PORT=5000
